{
  "name": "tickbell-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "TickBell 提醒系统前端（Vue 3 + Vite + Quasar）",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/vue-3": "^3.35.0",
    "pinia": "^3.0.0",
    "quasar": "^2.35.6",
    "vue": "^3.5.46",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "sass-embedded": "^1.108.2",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
