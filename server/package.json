{
  "name": "tickbell-server",
  "version": "1.0.1",
  "private": true,
  "description": "TickBell self-hosted reminder system backend (NestJS + SQLite)",
  "license": "MIT",
  "scripts": {
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "build:all": "node scripts/build-all.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/throttler": "^6.8.0",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "nestjs-pino": "^5.3.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^8.13.1",
    "xss": "^1.0.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@swc/core": "^1.16.22",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "typescript": "~5.9",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.0.18"
  }
}
