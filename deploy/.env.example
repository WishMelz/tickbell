# 极简部署配置：所有项均可选（不创建 .env 也能直接启动）
# 管理密码与系统密钥在首次打开网页时手动设置并保存在 SQLite（./data/tickbell.db）中，无需写入环境变量。

# 对外服务端口（默认 3000）
# PORT=3000

# 数据库与自动备份路径（均位于挂载的 /data 目录内）
# DB_PATH=/data/tickbell.db
# BACKUP_DIR=/data/backups

# 以下均为可选微调项（默认已合理配置，一般不用改）：
# COOKIE_SECURE=auto
# TRUST_PROXY=true
# ALLOW_PRIVATE_URLS=true
# MISSED_GRACE_MINUTES=60
# DELIVERY_RETENTION_DAYS=90
# BACKUP_KEEP_DAYS=14
